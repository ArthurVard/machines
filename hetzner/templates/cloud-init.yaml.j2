#cloud-config
# Rendered by rebuild.yml for {{ inventory_hostname }}.
# No secrets in here: Hetzner stores user_data, and any process on the server can read it back.
users:
  - name: {{ admin_user }}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true                 # SSH keys only; if locked out, use the Hetzner rescue system
    ssh_authorized_keys:
{% for pub in admin_ssh_pub_key_files %}
      - {{ lookup('ansible.builtin.file', pub | expanduser) | trim | to_json }}
{% endfor %}

disable_root: true
ssh_pwauth: false

package_update: true
package_upgrade: true
packages:
  - fail2ban
  - ufw
  - docker.io
  - docker-compose-v2
{% if swap_size %}

swap:
  filename: /swapfile
  size: {{ swap_size }}
{% endif %}

write_files:
  # First in sshd_config.d, so it wins: sshd keeps the first value it reads.
  - path: /etc/ssh/sshd_config.d/00-hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AllowTcpForwarding local
      AllowAgentForwarding no
      X11Forwarding no
      AllowUsers {{ admin_user }}
  - path: /etc/fail2ban/jail.local
    defer: true                       # written after fail2ban is installed
    content: |
      [sshd]
      enabled = true
      banaction = iptables-multiport

# The login banner comes from site.yml (role "base"), not from here.
runcmd:
  - usermod -aG docker {{ admin_user }}
  - ufw allow OpenSSH
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable
  - systemctl restart fail2ban        # load jail.local (fail2ban started before it was written)

# No power_state reboot here: site.yml reboots when the upgrade needs it, and waits for the server.
